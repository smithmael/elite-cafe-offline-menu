{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|apple-touch-icon|safari-pinned-tab)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "images",
      "urls": [
        "https://picsum.photos/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "30d",
        "timeout": "10s",
        "strategy": "performance"
      }
    }
  ]
}
